<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Oms.Client.Modules.Shell"
             xmlns:notification="using:Oms.Client.Modules.Notification"
             x:Class="Oms.Client.Modules.Shell.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="appbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource SystemAccentColor}">
            <TextBlock Text="Y" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="YOMS" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
          <Border Classes="pill status" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ConnectionStatus}" />
            </StackPanel>
          </Border>
          <TextBox Width="150" Text="{Binding Session.Login}" PlaceholderText="Login" IsVisible="{Binding !IsConnected}" />
          <Button Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}">
          <StackPanel><mi:MaterialIcon Kind="Connection" /><TextBlock Text="Connect" /></StackPanel>
        </Button>
          <Button Classes="accent" Command="{Binding CreateOrderCommand}">
          <StackPanel><mi:MaterialIcon Kind="Plus" /><TextBlock Text="New order" /></StackPanel>
        </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="1" Margin="20,12,20,20" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DocumentViewModel">
          <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:DocumentViewModel">
          <ContentControl Content="{Binding}" Margin="0,12,0,0" />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Toast-like notifications, bottom right, over the documents. -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Notifications}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="notification:NotificationViewModel">
          <ContentControl Content="{Binding}" Margin="0,4,0,0" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
