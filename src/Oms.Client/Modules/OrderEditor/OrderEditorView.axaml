<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Oms.Client.Modules.OrderEditor"
        x:Class="Oms.Client.Modules.OrderEditor.OrderEditorView"
        x:DataType="vm:OrderEditorViewModel"
        Title="Order Editor" Width="760" Height="480" WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,*,Auto" Margin="12">
    <AutoCompleteBox Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"
                     ItemsSource="{Binding SearchResults}"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     FilterMode="None" MinimumPrefixLength="0" Watermark="Search..." />
    <Button Grid.Row="1" Grid.Column="0" Content="Search" Command="{Binding SearchCommand}"
            VerticalAlignment="Top" Margin="0,12,12,0" />

    <ListBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" ItemsSource="{Binding LogData}" />

    <Button Grid.Row="2" Grid.Column="1" Content="Close" Command="{Binding CloseCommand}"
            HorizontalAlignment="Right" Margin="0,12,0,0" />
  </Grid>
</Window>
