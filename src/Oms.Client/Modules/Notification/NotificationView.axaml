<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oms.Client.Modules.Notification"
             x:Class="Oms.Client.Modules.Notification.NotificationView"
             x:DataType="vm:NotificationViewModel">
  <Border BorderBrush="#FFFFBE00" BorderThickness="5,0,0,0" CornerRadius="5,0,0,5">
    <Border BorderThickness="7,1,1,1" BorderBrush="#FFFFBE00" Padding="3" Background="#FF3E3E42" CornerRadius="0,5,5,0">
      <DockPanel Width="200" Height="40" DataContext="{Binding Notification}">
        <TextBlock Text="{Binding Title}" DockPanel.Dock="Top" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="{Binding Description}" Foreground="White" />
      </DockPanel>
    </Border>
  </Border>
</UserControl>
