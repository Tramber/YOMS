<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Oms.Client.Modules.Notification"
             x:Class="Oms.Client.Modules.Notification.NotificationView"
             x:DataType="vm:NotificationViewModel">
  <Border BorderBrush="{StaticResource Warn}" BorderThickness="4,0,0,0" CornerRadius="8" ClipToBounds="True"
          Background="{StaticResource Raised}" Padding="14,10" Width="320" BoxShadow="0 6 18 0 #80000000">
    <Grid ColumnDefinitions="Auto,*" DataContext="{Binding Notification}">
      <mi:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top"
                       Foreground="{StaticResource Warn}" />
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
