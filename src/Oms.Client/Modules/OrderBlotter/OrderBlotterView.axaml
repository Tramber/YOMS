<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Oms.Client.Modules.OrderBlotter"
             xmlns:model="using:Oms.Client.Model"
             x:Class="Oms.Client.Modules.OrderBlotter.OrderBlotterView"
             x:DataType="vm:OrderBlotterViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="340" Text="{Binding FilterText}" PlaceholderText="Filter, e.g. Security.IsinCode = &quot;FR0000000001&quot;" >
          <TextBox.InnerLeftContent><mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0" Opacity="0.6" /></TextBox.InnerLeftContent>
        </TextBox>
        <Button Command="{Binding GroupOrdersCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="VectorCombine" /><TextBlock Text="Group" /></StackPanel>
        </Button>
        <Button Command="{Binding UnGroupOrdersCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="VectorDifferenceAb" /><TextBlock Text="Ungroup" /></StackPanel>
        </Button>
      </StackPanel>
      <!-- Commands for the selected orders, grouped by purpose; the server refuses the ones the order state does not allow. -->
      <WrapPanel>
        <WrapPanel.Styles>
          <Style Selector="Button"><Setter Property="Margin" Value="0,0,8,8" /></Style>
        </WrapPanel.Styles>
        <Button Command="{Binding EditOrderCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="Pencil" /><TextBlock Text="Edit" /></StackPanel>
        </Button>
        <Button Command="{Binding RecallOrdersCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="UndoVariant" /><TextBlock Text="Recall" /></StackPanel>
        </Button>
        <Button Classes="danger" Command="{Binding CancelOrdersCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="Cancel" /><TextBlock Text="Cancel" /></StackPanel>
        </Button>
        <Button Classes="danger" Command="{Binding DeleteOrdersCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="Delete" /><TextBlock Text="Delete" /></StackPanel>
        </Button>
        <Border Classes="divider" />
        <Button Command="{Binding AcceptPendingCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="CheckCircleOutline" /><TextBlock Text="Accept pending" /></StackPanel>
        </Button>
        <Button Classes="danger" Command="{Binding RejectPendingCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="CloseCircleOutline" /><TextBlock Text="Reject pending" /></StackPanel>
        </Button>
        <Border Classes="divider" />
        <Button Command="{Binding SendToMarketCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="Send" /><TextBlock Text="Send to market" /></StackPanel>
        </Button>
        <Button Classes="danger" Command="{Binding CancelAtMarketCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="CloseOctagonOutline" /><TextBlock Text="Cancel at market" /></StackPanel>
        </Button>
        <Button Command="{Binding ExecuteOrdersCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="Flash" /><TextBlock Text="Execute" /></StackPanel>
        </Button>
        <Button Command="{Binding StartBookingCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="BookOpenVariant" /><TextBlock Text="Start booking" /></StackPanel>
        </Button>
        <Button Command="{Binding BookTradesCommand}" CommandParameter="{Binding #Grid.SelectedItems}">
          <StackPanel><mi:MaterialIcon Kind="BookCheck" /><TextBlock Text="Book trades" /></StackPanel>
        </Button>
      </WrapPanel>
    </StackPanel>

    <DataGrid x:Name="Grid" ItemsSource="{Binding OrdersView}" SelectionMode="Extended"
              IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Id" Binding="{Binding Id}" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Reference" Binding="{Binding ClientOrderRef}" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Security" Binding="{Binding SecurityName}" FontWeight="SemiBold" />
        <DataGridTemplateColumn Header="Way">
          <DataTemplate x:DataType="model:OrderAdapter">
            <Border Classes="pill" Classes.buy="{Binding IsBuy}" Classes.sell="{Binding !IsBuy}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
              <TextBlock Text="{Binding Way}" FontWeight="SemiBold" />
            </Border>
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Type" Binding="{Binding OrderType}" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Quantity" Binding="{Binding Quantity}" CellStyleClasses="num" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Remaining" Binding="{Binding RemainingQuantity}" CellStyleClasses="num" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Price" Binding="{Binding Price, StringFormat=N2}" CellStyleClasses="num" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="State" Binding="{Binding State}" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Status" Binding="{Binding Status}" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Group" Binding="{Binding GroupId}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
