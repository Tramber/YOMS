<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blotter="using:Oms.Client.Modules.OrderBlotter"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:notification="using:Oms.Client.Modules.Notification"
             x:Class="Oms.Client.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Deep navy surfaces, one cobalt accent. Buy/Sell/Warn colours below are reserved for meaning. -->
        <ColorPaletteResources x:Key="Dark" Accent="#4C7DFF" RegionColor="#0B1220" ErrorText="#FF6B7A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <mi:MaterialIconStyles />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window, UserControl"><Setter Property="FontFamily" Value="Inter" /></Style>

    <!-- Controls -->
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Button > StackPanel > mi|MaterialIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource Sell}" /></Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FF6B7A" />
      <Setter Property="Foreground" Value="{DynamicResource Sell}" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown"><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- App bar, toolbar groups and badges -->
    <Style Selector="Border.appbar">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="20,12" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Line}" />
      <Setter Property="Margin" Value="4,2,12,10" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
    <Style Selector="Border.pill > TextBlock"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Border.pill.buy"><Setter Property="Background" Value="#262DD4A7" /></Style>
    <Style Selector="Border.pill.buy > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Buy}" /></Style>
    <Style Selector="Border.pill.sell"><Setter Property="Background" Value="#26FF6B7A" /></Style>
    <Style Selector="Border.pill.sell > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Sell}" /></Style>
    <Style Selector="Border.pill.status"><Setter Property="Background" Value="{DynamicResource Raised}" /></Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Ellipse.dot.on"><Setter Property="Fill" Value="{DynamicResource Buy}" /></Style>

    <!-- Blotter grid -->
    <Style Selector="DataGrid">
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="RowHeight" Value="38" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Raised}" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGridCell.num TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
  </Application.Styles>

  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#131C2E" />
    <SolidColorBrush x:Key="Raised" Color="#1B2740" />
    <SolidColorBrush x:Key="Line" Color="#263552" />
    <SolidColorBrush x:Key="Muted" Color="#8A98B3" />
    <SolidColorBrush x:Key="Buy" Color="#2DD4A7" />
    <SolidColorBrush x:Key="Sell" Color="#FF6B7A" />
    <SolidColorBrush x:Key="Warn" Color="#F5B84B" />
    <x:Double x:Key="TabItemHeaderFontSize">14</x:Double>
  </Application.Resources>

  <!-- View models are shown by type: documents in the shell tabs, notifications in the overlay. -->
  <Application.DataTemplates>
    <DataTemplate DataType="blotter:OrderBlotterViewModel">
      <blotter:OrderBlotterView />
    </DataTemplate>
    <DataTemplate DataType="notification:NotificationViewModel">
      <notification:NotificationView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
