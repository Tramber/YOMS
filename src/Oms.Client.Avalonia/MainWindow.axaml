<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Oms.Client.Avalonia"
        xmlns:model="using:Oms.Client.Model"
        x:Class="Oms.Client.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OMS (Avalonia proof of concept)" Width="900" Height="600">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Filter" VerticalAlignment="Center" />
      <TextBox Width="200" Text="{Binding FilterText}" />
      <Button Content="Group" Command="{Binding GroupOrdersCommand}" CommandParameter="{Binding #Grid.SelectedItems}" />
      <Button Content="Ungroup" Command="{Binding UnGroupOrdersCommand}" CommandParameter="{Binding #Grid.SelectedItems}" />
      <Button Content="Notify" Command="{Binding CreateNotificationCommand}" />
      <Button Content="Connect to server" Command="{Binding ConnectCommand}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="4">
      <TextBlock Text="{Binding ConnectionStatus}" />
      <ItemsControl ItemsSource="{Binding Notifications}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NotificationItem">
            <TextBlock Text="{Binding Text}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <DataGrid x:Name="Grid" ItemsSource="{Binding OrdersView}" SelectionMode="Extended"
              IsReadOnly="True" CanUserSortColumns="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Id" Binding="{Binding Id}" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Price" Binding="{Binding Price, StringFormat=N2}" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="Quantity" Binding="{Binding Quantity}" />
        <DataGridTextColumn x:DataType="model:OrderAdapter" Header="GroupId" Binding="{Binding GroupId}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
