<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Oms.Transport\Oms.Transport.csproj" />
  </ItemGroup>
  <!-- Code shared with the WPF client: it has no WPF dependency. -->
  <ItemGroup>
    <Compile Include="..\Oms.Client\Model\OrderAdapter.cs" Link="Shared\OrderAdapter.cs" />
    <Compile Include="..\Oms.Client\Services\OrderServiceProxy.cs" Link="Shared\OrderServiceProxy.cs" />
    <Compile Include="..\Oms.Client\Services\Notifications\*.cs" Link="Shared\Notifications\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
